{% extends 'base.html.twig' %}

{% block title %}Book Appointment - MediDent{% endblock %}

{% block styles %}
<style>
    /* Page Header */
    .page-header {
        background: linear-gradient(135deg, rgba(26, 115, 167, 0.95), rgba(45, 189, 182, 0.9)), var(--page-header-image) center/cover;
        padding: 120px 0 80px;
        text-align: center;
        color: var(--white);
    }
    
    .page-header h1 {
        font-size: 48px;
        margin-bottom: 15px;
    }
    
    .breadcrumb {
        display: flex;
        justify-content: center;
        gap: 10px;
        list-style: none;
    }
    
    .breadcrumb a {
        color: rgba(255, 255, 255, 0.8);
    }
    
    .breadcrumb a:hover {
        color: var(--white);
    }
    
    .breadcrumb .active {
        color: var(--white);
    }
    
    /* Booking Section */
    .booking-section {
        padding: 100px 0;
    }
    
    .booking-container {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 50px;
    }
    
    /* Booking Form */
    .booking-form-card {
        background: var(--white);
        border-radius: 20px;
        padding: 50px;
        box-shadow: var(--shadow);
    }
    
    .booking-form-card h2 {
        font-size: 28px;
        color: var(--dark-blue);
        margin-bottom: 30px;
    }
    
    .form-steps {
        display: flex;
        justify-content: space-between;
        margin-bottom: 40px;
        position: relative;
    }
    
    .form-steps::before {
        content: '';
        position: absolute;
        top: 20px;
        left: 0;
        right: 0;
        height: 2px;
        background: var(--gray-200);
        z-index: 0;
    }
    
    .form-step {
        display: flex;
        flex-direction: column;
        align-items: center;
        position: relative;
        z-index: 1;
    }
    
    .step-number {
        width: 45px;
        height: 45px;
        background: var(--gray-200);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        color: var(--gray-600);
        margin-bottom: 10px;
        transition: var(--transition);
    }
    
    .form-step.active .step-number {
        background: var(--gradient);
        color: var(--white);
    }
    
    .form-step.completed .step-number {
        background: var(--primary-teal);
        color: var(--white);
    }
    
    .step-label {
        font-size: 13px;
        color: var(--gray-600);
        font-weight: 500;
    }
    
    .form-step.active .step-label {
        color: var(--primary-blue);
    }
    
    /* Form Fields */
    .form-section {
        margin-bottom: 30px;
    }
    
    .form-section h3 {
        font-size: 18px;
        color: var(--dark-blue);
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    
    .form-section h3 i {
        color: var(--primary-teal);
    }
    
    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }
    
    .form-group {
        margin-bottom: 20px;
    }
    
    .form-group label {
        display: block;
        font-weight: 500;
        margin-bottom: 8px;
        color: var(--gray-800);
    }
    
    .form-group input,
    .form-group select,
    .form-group textarea {
        width: 100%;
        padding: 15px 20px;
        border: 2px solid var(--gray-200);
        border-radius: 12px;
        font-family: inherit;
        font-size: 15px;
        transition: var(--transition);
    }
    
    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
        outline: none;
        border-color: var(--primary-teal);
        box-shadow: 0 0 0 4px rgba(45, 189, 182, 0.1);
    }
    
    .form-group textarea {
        min-height: 120px;
        resize: vertical;
    }
    
    /* Service Selection */
    .service-options {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 15px;
    }
    
    .service-option {
        position: relative;
    }
    
    .service-option input {
        position: absolute;
        opacity: 0;
    }
    
    .service-option label {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 20px;
        border: 2px solid var(--gray-200);
        border-radius: 12px;
        cursor: pointer;
        transition: var(--transition);
    }
    
    .service-option input:checked + label {
        border-color: var(--primary-teal);
        background: var(--light-blue);
    }
    
    .service-option label i {
        font-size: 24px;
        color: var(--primary-teal);
    }
    
    .service-option label span {
        font-weight: 500;
    }
    
    /* Date & Time Selection */
    .time-slots {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 10px;
    }
    
    .time-slot {
        position: relative;
    }
    
    .time-slot input {
        position: absolute;
        opacity: 0;
    }
    
    .time-slot label {
        display: block;
        text-align: center;
        padding: 12px;
        border: 2px solid var(--gray-200);
        border-radius: 10px;
        cursor: pointer;
        transition: var(--transition);
        font-weight: 500;
    }
    
    .time-slot input:checked + label {
        border-color: var(--primary-teal);
        background: var(--gradient);
        color: var(--white);
    }
    
    .time-slot label:hover {
        border-color: var(--primary-teal);
    }
    
    /* Form Buttons */
    .form-buttons {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        margin-top: 30px;
    }
    
    /* Sidebar */
    .booking-sidebar {
        position: sticky;
        top: 100px;
    }
    
    .sidebar-card {
        background: var(--white);
        border-radius: 20px;
        padding: 30px;
        box-shadow: var(--shadow);
        margin-bottom: 30px;
    }
    
    .sidebar-card h3 {
        font-size: 18px;
        color: var(--dark-blue);
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    
    .sidebar-card h3 i {
        color: var(--primary-teal);
    }
    
    .summary-item {
        display: flex;
        justify-content: space-between;
        padding: 12px 0;
        border-bottom: 1px solid var(--gray-200);
    }
    
    .summary-item:last-child {
        border-bottom: none;
    }
    
    .summary-item span:first-child {
        color: var(--gray-600);
    }
    
    .summary-item span:last-child {
        font-weight: 600;
        color: var(--dark-blue);
    }
    
    .sidebar-info-item {
        display: flex;
        align-items: flex-start;
        gap: 15px;
        margin-bottom: 20px;
    }
    
    .sidebar-info-item i {
        width: 40px;
        height: 40px;
        background: var(--light-blue);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--primary-teal);
        flex-shrink: 0;
    }
    
    .sidebar-info-item h4 {
        font-size: 14px;
        color: var(--dark-blue);
        margin-bottom: 3px;
    }
    
    .sidebar-info-item p {
        font-size: 13px;
        color: var(--gray-600);
    }
    
    /* Emergency CTA */
    .emergency-cta {
        background: linear-gradient(135deg, #ff6b6b, #ee5a5a);
        border-radius: 20px;
        padding: 30px;
        color: var(--white);
        text-align: center;
    }
    
    .emergency-cta i {
        font-size: 40px;
        margin-bottom: 15px;
    }
    
    .emergency-cta h3 {
        margin-bottom: 10px;
        color: var(--white);
    }
    
    .emergency-cta p {
        font-size: 14px;
        opacity: 0.9;
        margin-bottom: 20px;
    }
    
    .emergency-cta a {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: var(--white);
        color: #ff6b6b;
        padding: 12px 25px;
        border-radius: 50px;
        font-weight: 600;
    }
    
    @media (max-width: 1024px) {
        .booking-container {
            grid-template-columns: 1fr;
        }
        
        .booking-sidebar {
            position: static;
        }
    }
    
    @media (max-width: 768px) {
        .page-header h1 {
            font-size: 32px;
        }
        
        .booking-form-card {
            padding: 30px 20px;
        }
        
        .form-row {
            grid-template-columns: 1fr;
        }
        
        .service-options {
            grid-template-columns: 1fr;
        }
        
        .time-slots {
            grid-template-columns: repeat(2, 1fr);
        }
        
        .form-steps {
            flex-wrap: wrap;
            gap: 20px;
        }
        
        .form-steps::before {
            display: none;
        }
    }
</style>
{% endblock %}

{% block body %}
    <!-- Page Header -->
    <section class="page-header" style="--page-header-image: url('https://images.unsplash.com/photo-1588771934966-7aa12acb266a?q=80&w=1920&auto=format&fit=crop')">
        <div class="container">
            <h1 data-aos="fade-up">Book an Appointment</h1>
            <ul class="breadcrumb" data-aos="fade-up" data-aos-delay="100">
                <li><a href="{{ path('app_home') }}">Home</a></li>
                <li>/</li>
                <li class="active">Book Appointment</li>
            </ul>
        </div>
    </section>
    
    <!-- Booking Section -->
    <section class="booking-section">
        <div class="container">
            <div class="booking-container">
                <!-- Booking Form -->
                <div class="booking-form-card" data-aos="fade-right">
                    <h2>Schedule Your Visit</h2>
                    
                    <!-- Progress Steps -->
                    <div class="form-steps">
                        <div class="form-step active">
                            <div class="step-number">1</div>
                            <span class="step-label">Service</span>
                        </div>
                        <div class="form-step">
                            <div class="step-number">2</div>
                            <span class="step-label">Date & Time</span>
                        </div>
                        <div class="form-step">
                            <div class="step-number">3</div>
                            <span class="step-label">Details</span>
                        </div>
                        <div class="form-step">
                            <div class="step-number">4</div>
                            <span class="step-label">Confirm</span>
                        </div>
                    </div>
                    
                    {% for label, messages in app.flashes %}
                        {% for message in messages %}
                            <div class="alert alert-{{ label }}">{{ message }}</div>
                        {% endfor %}
                    {% endfor %}
                    <form action="{{ path('app_appointment') }}" method="POST">
                        <div class="form-section" data-step="1">
                            <h3><i class="fas fa-list"></i> Select Service</h3>
                            <div class="service-options" id="serviceOptions">
                                {% if services is defined and services %}
                                {% for s in services %}
                                    <div class="service-option">
                                        <input type="radio" name="service" id="srv_{{ s.id }}" value="{{ s.name }}" {% if loop.first %}checked{% endif %}>
                                        <label for="srv_{{ s.id }}">
                                            <i class="fas fa-tag"></i>
                                            <span>{{ s.name }}</span>
                                        </label>
                                    </div>
                                {% endfor %}
                                {% else %}
                                    <div class="service-option">
                                        <input type="radio" name="service" id="svc_general" value="General Checkup" checked>
                                        <label for="svc_general"><i class="fas fa-tooth"></i><span>General Checkup</span></label>
                                    </div>
                                    <div class="service-option">
                                        <input type="radio" name="service" id="svc_cleaning" value="Teeth Cleaning">
                                        <label for="svc_cleaning"><i class="fas fa-tooth"></i><span>Teeth Cleaning</span></label>
                                    </div>
                                    <div class="service-option">
                                        <input type="radio" name="service" id="svc_whitening" value="Teeth Whitening">
                                        <label for="svc_whitening"><i class="fas fa-tooth"></i><span>Teeth Whitening</span></label>
                                    </div>
                                    <div class="service-option">
                                        <input type="radio" name="service" id="svc_braces" value="Braces Consultation">
                                        <label for="svc_braces"><i class="fas fa-tooth"></i><span>Braces Consultation</span></label>
                                    </div>
                                    <div class="service-option">
                                        <input type="radio" name="service" id="svc_implants" value="Dental Implants">
                                        <label for="svc_implants"><i class="fas fa-tooth"></i><span>Dental Implants</span></label>
                                    </div>
                                    <div class="service-option">
                                        <input type="radio" name="service" id="svc_emergency" value="Emergency Care">
                                        <label for="svc_emergency"><i class="fas fa-tooth"></i><span>Emergency Care</span></label>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                        
                        <!-- Date & Time -->
                        <div class="form-section" data-step="2">
                            <h3><i class="fas fa-calendar-alt"></i> Select Date & Time</h3>
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="date">Preferred Date</label>
                                    <input type="date" id="date" name="date" required>
                                </div>
                                <div class="form-group">
                                    <label for="doctor">Preferred Doctor</label>
                                    <select id="doctor" name="doctor">
                                        <option value="">Any Available Doctor</option>
                                        <option value="dr-smith">Dr. John Smith</option>
                                        <option value="dr-johnson">Dr. Sarah Johnson</option>
                                        <option value="dr-lee">Dr. Michael Lee</option>
                                        <option value="dr-davis">Dr. Emily Davis</option>
                                    </select>
                                </div>
                            </div>
                            
                            <div class="form-group">
                                <label>Available Time Slots</label>
                                <div class="time-slots">
                                    <div class="time-slot">
                                        <input type="radio" name="time" id="time1" value="09:00">
                                        <label for="time1">9:00 AM</label>
                                    </div>
                                    <div class="time-slot">
                                        <input type="radio" name="time" id="time2" value="10:00">
                                        <label for="time2">10:00 AM</label>
                                    </div>
                                    <div class="time-slot">
                                        <input type="radio" name="time" id="time3" value="11:00">
                                        <label for="time3">11:00 AM</label>
                                    </div>
                                    <div class="time-slot">
                                        <input type="radio" name="time" id="time4" value="12:00">
                                        <label for="time4">12:00 PM</label>
                                    </div>
                                    <div class="time-slot">
                                        <input type="radio" name="time" id="time5" value="14:00">
                                        <label for="time5">2:00 PM</label>
                                    </div>
                                    <div class="time-slot">
                                        <input type="radio" name="time" id="time6" value="15:00">
                                        <label for="time6">3:00 PM</label>
                                    </div>
                                    <div class="time-slot">
                                        <input type="radio" name="time" id="time7" value="16:00">
                                        <label for="time7">4:00 PM</label>
                                    </div>
                                    <div class="time-slot">
                                        <input type="radio" name="time" id="time8" value="17:00">
                                        <label for="time8">5:00 PM</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Personal Information -->
                        <div class="form-section" data-step="3">
                            <h3><i class="fas fa-user"></i> Your Information</h3>
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="firstName">First Name</label>
                                    <input type="text" id="firstName" name="firstName" placeholder="Enter your first name" required>
                                </div>
                                <div class="form-group">
                                    <label for="lastName">Last Name</label>
                                    <input type="text" id="lastName" name="lastName" placeholder="Enter your last name" required>
                                </div>
                            </div>
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="email">Email Address</label>
                                    <input type="email" id="email" name="email" placeholder="Enter your email" required>
                                </div>
                                <div class="form-group">
                                    <label for="phone">Phone Number</label>
                                    <input type="tel" id="phone" name="phone" placeholder="Enter your phone number" required>
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="notes">Additional Notes (Optional)</label>
                                <textarea id="notes" name="notes" placeholder="Any specific concerns or requests..."></textarea>
                            </div>
                        </div>
                        
                        <div class="form-section" data-step="4">
                            <h3><i class="fas fa-clipboard-check"></i> Review & Confirm</h3>
                            <div class="sidebar-card">
                                <div class="summary-item">
                                    <span>Service</span>
                                    <span id="confirmService">Select a service</span>
                                </div>
                                <div class="summary-item">
                                    <span>Date</span>
                                    <span id="confirmDate">Select a date</span>
                                </div>
                                <div class="summary-item">
                                    <span>Time</span>
                                    <span id="confirmTime">Select a time</span>
                                </div>
                                <div class="summary-item">
                                    <span>Doctor</span>
                                    <span id="confirmDoctor">Any Available</span>
                                </div>
                            </div>
                            <div class="sidebar-card" style="margin-top:16px;">
                                <h4><i class="fas fa-credit-card"></i> Payment Method</h4>
                                <div class="form-row">
                                    <div class="form-group">
                                        <label>
                                            <input type="radio" name="payment_method" value="cash" checked>
                                            Cash (pay at clinic)
                                        </label>
                                    </div>
                                    <div class="form-group">
                                        <label>
                                            <input type="radio" name="payment_method" value="stripe">
                                            Stripe (pay online)
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div class="form-buttons">
                                <button type="submit" class="btn btn-primary" style="width: 100%;">
                                    <i class="fas fa-calendar-check"></i> Confirm Appointment
                                </button>
                            </div>
                        </div>
                        <div class="form-buttons">
                            <button type="button" class="btn btn-outline" id="prevStep"><i class="fas fa-arrow-left"></i> Back</button>
                            <button type="button" class="btn btn-secondary" id="nextStep">Next <i class="fas fa-arrow-right"></i></button>
                        </div>
                    </form>
                </div>
                
                <!-- Sidebar -->
                <div class="booking-sidebar" data-aos="fade-left">
                    <!-- Appointment Summary -->
                    <div class="sidebar-card">
                        <h3><i class="fas fa-clipboard-list"></i> Appointment Summary</h3>
                        <div class="summary-item">
                            <span>Service</span>
                            <span id="summaryService">Select a service</span>
                        </div>
                        <div class="summary-item">
                            <span>Date</span>
                            <span id="summaryDate">Select a date</span>
                        </div>
                        <div class="summary-item">
                            <span>Time</span>
                            <span id="summaryTime">Select a time</span>
                        </div>
                        <div class="summary-item">
                            <span>Doctor</span>
                            <span id="summaryDoctor">Any Available</span>
                        </div>
                    </div>
                    
                    <!-- Info Cards -->
                    <div class="sidebar-card">
                        <h3><i class="fas fa-info-circle"></i> Important Information</h3>
                        <div class="sidebar-info-item">
                            <i class="fas fa-clock"></i>
                            <div>
                                <h4>Arrive 15 Minutes Early</h4>
                                <p>Please arrive early to complete any paperwork</p>
                            </div>
                        </div>
                        <div class="sidebar-info-item">
                            <i class="fas fa-id-card"></i>
                            <div>
                                <h4>Bring Your ID</h4>
                                <p>Valid ID and insurance card required</p>
                            </div>
                        </div>
                        <div class="sidebar-info-item">
                            <i class="fas fa-phone"></i>
                            <div>
                                <h4>Cancel Policy</h4>
                                <p>24-hour notice required for cancellations</p>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Emergency CTA -->
                    <div class="emergency-cta">
                        <i class="fas fa-exclamation-triangle"></i>
                        <h3>Dental Emergency?</h3>
                        <p>Don't wait! Call our emergency line for immediate assistance.</p>
                        <a href="tel:+1234567891">
                            <i class="fas fa-phone-alt"></i> Call Emergency Line
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}

{% block scripts %}
<script>
    document.querySelectorAll('input[name="service"]').forEach(radio => {
        radio.addEventListener('change', (e) => {
            const label = document.querySelector(`label[for="${e.target.id}"] span`).textContent;
            document.getElementById('summaryService').textContent = label;
            const el = document.getElementById('confirmService');
            if (el) el.textContent = label;
        });
    });
    
    document.getElementById('date').addEventListener('change', (e) => {
        const date = new Date(e.target.value);
        const formatted = date.toLocaleDateString('en-US', {
            weekday: 'short',
            month: 'short',
            day: 'numeric'
        });
        document.getElementById('summaryDate').textContent = formatted;
        const el = document.getElementById('confirmDate');
        if (el) el.textContent = formatted;
    });
    
    document.querySelectorAll('input[name="time"]').forEach(radio => {
        radio.addEventListener('change', (e) => {
            const label = document.querySelector(`label[for="${e.target.id}"]`).textContent;
            document.getElementById('summaryTime').textContent = label;
            const el = document.getElementById('confirmTime');
            if (el) el.textContent = label;
        });
    });
    
    document.getElementById('doctor').addEventListener('change', (e) => {
        const text = e.target.options[e.target.selectedIndex].text;
        document.getElementById('summaryDoctor').textContent = text;
        const el = document.getElementById('confirmDoctor');
        if (el) el.textContent = text;
    });

    let currentStep = 1;
    const sections = Array.from(document.querySelectorAll('.booking-form-card .form-section'));
    const steps = Array.from(document.querySelectorAll('.form-steps .form-step'));
    const prevBtn = document.getElementById('prevStep');
    const nextBtn = document.getElementById('nextStep');

    function updateUI() {
        sections.forEach((s, i) => { s.style.display = i === currentStep - 1 ? 'block' : 'none'; });
        steps.forEach((s, i) => {
            s.classList.toggle('active', i === currentStep - 1);
            s.classList.toggle('completed', i < currentStep - 1);
        });
        prevBtn.style.visibility = currentStep === 1 ? 'hidden' : 'visible';
        nextBtn.style.display = currentStep === 4 ? 'none' : 'inline-flex';
        if (currentStep === 4) {
            const serviceRadio = document.querySelector('input[name="service"]:checked');
            if (serviceRadio) {
                const label = document.querySelector(`label[for="${serviceRadio.id}"] span`).textContent;
                document.getElementById('confirmService').textContent = label;
            }
            const dateInput = document.getElementById('date');
            if (dateInput.value) {
                const date = new Date(dateInput.value);
                const formatted = date.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' });
                document.getElementById('confirmDate').textContent = formatted;
            }
            const timeRadio = document.querySelector('input[name="time"]:checked');
            if (timeRadio) {
                const label = document.querySelector(`label[for="${timeRadio.id}"]`).textContent;
                document.getElementById('confirmTime').textContent = label;
            }
            const doctorSelect = document.getElementById('doctor');
            const text = doctorSelect.options[doctorSelect.selectedIndex].text;
            document.getElementById('confirmDoctor').textContent = text;
        }
    }

    prevBtn.addEventListener('click', () => {
        if (currentStep > 1) { currentStep -= 1; updateUI(); }
    });
    nextBtn.addEventListener('click', () => {
        if (currentStep < 4) { currentStep += 1; updateUI(); }
    });
    updateUI();
</script>
{% endblock %}
