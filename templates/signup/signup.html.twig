{% extends 'base.html.twig' %}

{% block title %}Sign Up - MediDent{% endblock %}

{% block styles %}
<style>
    /* Auth Page Styles */
    .auth-section {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, rgba(26, 115, 167, 0.05), rgba(45, 189, 182, 0.08));
        padding: 180px 20px 80px;
        position: relative;
        overflow: hidden;
    }
    
    .auth-section::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -20%;
        width: 600px;
        height: 600px;
        background: radial-gradient(circle, rgba(45, 189, 182, 0.1) 0%, transparent 70%);
        border-radius: 50%;
        animation: float 6s ease-in-out infinite;
    }
    
    .auth-section::after {
        content: '';
        position: absolute;
        bottom: -30%;
        left: -10%;
        width: 400px;
        height: 400px;
        background: radial-gradient(circle, rgba(26, 115, 167, 0.1) 0%, transparent 70%);
        border-radius: 50%;
        animation: float 8s ease-in-out infinite reverse;
    }
    
    .auth-container {
        display: grid;
        grid-template-columns: 1fr 1.2fr;
        max-width: 1150px;
        width: 100%;
        background: var(--white);
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 25px 80px rgba(0, 0, 0, 0.1);
        position: relative;
        z-index: 1;
    }
    
    /* Auth Sidebar */
    .auth-sidebar {
        background: var(--gradient);
        padding: 60px 50px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        position: relative;
        overflow: hidden;
    }
    
    .auth-sidebar::before {
        content: '';
        position: absolute;
        top: -100px;
        right: -100px;
        width: 300px;
        height: 300px;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 50%;
    }
    
    .auth-sidebar::after {
        content: '';
        position: absolute;
        bottom: -50px;
        left: -50px;
        width: 200px;
        height: 200px;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 50%;
    }
    
    .auth-sidebar-content {
        position: relative;
        z-index: 1;
    }
    
    .auth-sidebar h2 {
        color: var(--white);
        font-size: 32px;
        margin-bottom: 20px;
        line-height: 1.3;
    }
    
    .auth-sidebar p {
        color: rgba(255, 255, 255, 0.85);
        font-size: 16px;
        line-height: 1.8;
        margin-bottom: 40px;
    }
    
    .auth-features {
        list-style: none;
    }
    
    .auth-features li {
        display: flex;
        align-items: center;
        gap: 15px;
        color: var(--white);
        margin-bottom: 20px;
        font-size: 15px;
    }
    
    .auth-features li i {
        width: 35px;
        height: 35px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
    }
    
    /* Testimonial in Sidebar */
    .sidebar-testimonial {
        margin-top: 40px;
        padding: 25px;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 16px;
        backdrop-filter: blur(10px);
    }
    
    .sidebar-testimonial p {
        font-style: italic;
        font-size: 15px;
        margin-bottom: 15px;
        color: rgba(255, 255, 255, 0.95);
    }
    
    .sidebar-testimonial .author {
        display: flex;
        align-items: center;
        gap: 12px;
    }
    
    .sidebar-testimonial .author img {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid rgba(255, 255, 255, 0.3);
    }
    
    .sidebar-testimonial .author-info span {
        display: block;
        color: var(--white);
        font-weight: 600;
        font-size: 14px;
    }
    
    .sidebar-testimonial .author-info small {
        color: rgba(255, 255, 255, 0.7);
        font-size: 12px;
    }
    
    /* Auth Form */
    .auth-form-container {
        padding: 50px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        overflow-y: auto;
        max-height: 100vh;
    }
    
    .auth-logo {
        margin-bottom: 25px;
    }
    
    .auth-logo img {
        height: 50px;
    }
    
    .auth-form-container h1 {
        font-size: 28px;
        color: var(--dark-blue);
        margin-bottom: 10px;
    }
    
    .auth-form-container > p {
        color: var(--gray-600);
        margin-bottom: 30px;
    }
    
    .auth-form .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }
    
    .auth-form .form-group {
        margin-bottom: 20px;
    }
    
    .auth-form .form-group label {
        display: block;
        font-weight: 500;
        margin-bottom: 8px;
        color: var(--gray-800);
        font-size: 14px;
    }
    
    .input-wrapper {
        position: relative;
    }
    
    .input-wrapper i.icon {
        position: absolute;
        left: 18px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--gray-600);
        transition: var(--transition);
    }
    
    .input-wrapper input,
    .input-wrapper select {
        width: 100%;
        padding: 15px 20px 15px 50px;
        border: 2px solid var(--gray-200);
        border-radius: 12px;
        font-family: inherit;
        font-size: 15px;
        transition: var(--transition);
    }
    
    .input-wrapper input:focus,
    .input-wrapper select:focus {
        outline: none;
        border-color: var(--primary-teal);
        box-shadow: 0 0 0 4px rgba(45, 189, 182, 0.1);
    }
    
    .input-wrapper:focus-within i.icon {
        color: var(--primary-teal);
    }
    
    .password-toggle {
        position: absolute;
        right: 18px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        color: var(--gray-600);
        cursor: pointer;
        padding: 5px;
        transition: var(--transition);
    }
    
    .password-toggle:hover {
        color: var(--primary-blue);
    }
    
    /* Password Strength */
    .password-strength {
        margin-top: 10px;
    }
    
    .strength-bar {
        height: 4px;
        background: var(--gray-200);
        border-radius: 2px;
        overflow: hidden;
        margin-bottom: 8px;
    }
    
    .strength-fill {
        height: 100%;
        width: 0;
        transition: all 0.3s ease;
        border-radius: 2px;
    }
    
    .strength-fill.weak { width: 25%; background: #ef4444; }
    .strength-fill.fair { width: 50%; background: #f59e0b; }
    .strength-fill.good { width: 75%; background: #10b981; }
    .strength-fill.strong { width: 100%; background: #059669; }
    
    .strength-text {
        font-size: 12px;
        color: var(--gray-600);
    }
    
    /* Terms Checkbox */
    .terms-checkbox {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        margin-bottom: 25px;
    }
    
    .terms-checkbox input[type="checkbox"] {
        width: 18px;
        height: 18px;
        accent-color: var(--primary-teal);
        cursor: pointer;
        margin-top: 3px;
        flex-shrink: 0;
    }
    
    .terms-checkbox label {
        font-size: 14px;
        color: var(--gray-600);
        line-height: 1.5;
    }
    
    .terms-checkbox a {
        color: var(--primary-blue);
        font-weight: 500;
    }
    
    .terms-checkbox a:hover {
        text-decoration: underline;
    }
    
    .auth-btn {
        width: 100%;
        padding: 16px;
        background: var(--gradient);
        color: var(--white);
        border: none;
        border-radius: 12px;
        font-family: inherit;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: var(--transition);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
    }
    
    .auth-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(26, 115, 167, 0.3);
    }
    
    .auth-btn:disabled {
        opacity: 0.6;
        cursor: not-allowed;
        transform: none;
    }
    
    .auth-divider {
        display: flex;
        align-items: center;
        gap: 20px;
        margin: 25px 0;
    }
    
    .auth-divider::before,
    .auth-divider::after {
        content: '';
        flex: 1;
        height: 1px;
        background: var(--gray-200);
    }
    
    .auth-divider span {
        color: var(--gray-600);
        font-size: 14px;
    }
    
    .social-login {
        display: flex;
        gap: 15px;
    }
    
    .social-btn {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 14px;
        border: 2px solid var(--gray-200);
        border-radius: 12px;
        background: var(--white);
        color: var(--gray-800);
        font-weight: 500;
        font-size: 14px;
        cursor: pointer;
        transition: var(--transition);
    }
    
    .social-btn:hover {
        border-color: var(--primary-teal);
        background: var(--light-blue);
    }
    
    .social-btn.google i {
        color: #DB4437;
    }
    
    .social-btn.facebook i {
        color: #4267B2;
    }
    
    .auth-footer {
        text-align: center;
        margin-top: 25px;
        font-size: 14px;
        color: var(--gray-600);
    }
    
    .auth-footer a {
        color: var(--primary-blue);
        font-weight: 600;
    }
    
    .auth-footer a:hover {
        color: var(--primary-teal);
        text-decoration: underline;
    }
    
    /* Error/Success Messages */
    .alert {
        padding: 15px 20px;
        border-radius: 10px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 14px;
    }
    
    .alert-error {
        background: #fee2e2;
        color: #dc2626;
        border: 1px solid #fecaca;
    }
    
    .alert-success {
        background: #d1fae5;
        color: #059669;
        border: 1px solid #a7f3d0;
    }
    
    /* Field Validation */
    .form-group.error input,
    .form-group.error select {
        border-color: #ef4444;
    }
    
    .form-group .error-message {
        color: #ef4444;
        font-size: 12px;
        margin-top: 6px;
        display: none;
    }
    
    .form-group.error .error-message {
        display: block;
    }
    
    @media (max-width: 1024px) {
        .auth-container {
            grid-template-columns: 1fr;
            max-width: 550px;
        }
        
        .auth-sidebar {
            display: none;
        }
        
        .auth-form-container {
            padding: 40px 35px;
            max-height: none;
        }
    }
    
    @media (max-width: 600px) {
        .auth-section {
            padding: 100px 15px 60px;
        }
        
        .auth-form-container {
            padding: 30px 20px;
        }
        
        .auth-form .form-row {
            grid-template-columns: 1fr;
        }
        
        .social-login {
            flex-direction: column;
        }
    }
</style>
{% endblock %}

{% block body %}
<section class="auth-section">
    <div class="auth-container centered" data-aos="fade-up">
        <!-- Sidebar -->
        <div class="auth-sidebar">
            <div class="auth-sidebar-content">
                <h2>Start Your Journey to Better Dental Health</h2>
                <p>Join thousands of happy patients who trust MediDent for their dental care needs.</p>
                
                <ul class="auth-features">
                    <li>
                        <i class="fas fa-user-md"></i>
                        <span>Access to top dental specialists</span>
                    </li>
                    <li>
                        <i class="fas fa-clock"></i>
                        <span>24/7 online appointment booking</span>
                    </li>
                    <li>
                        <i class="fas fa-shield-alt"></i>
                        <span>Secure patient data protection</span>
                    </li>
                    <li>
                        <i class="fas fa-percentage"></i>
                        <span>Exclusive member discounts</span>
                    </li>
                </ul>
            </div>
        </div>
        
        <!-- Signup Form -->
        <div class="auth-form-container">
            <a href="{{ path('app_home') }}" class="auth-logo">
                <img src="/images/logo1.png" alt="MediDent">
            </a>
            
            <h1>Create Account</h1>
            <p>Fill in your details to get started with MediDent</p>
            
            {% if app.flashes('error') %}
                {% for message in app.flashes('error') %}
                    <div class="alert alert-error">
                        <i class="fas fa-exclamation-circle"></i>
                        {{ message }}
                    </div>
                {% endfor %}
            {% endif %}
            
            <form class="auth-form" action="{{ path('app_register') }}" method="POST" id="signupForm">
                <div class="form-row">
                    <div class="form-group">
                        <label for="firstName">First Name</label>
                        <div class="input-wrapper">
                            <input type="text" id="firstName" name="firstName" placeholder="Enter first name" required>
                            <i class="fas fa-user icon"></i>
                        </div>
                        <span class="error-message">Please enter your first name</span>
                    </div>
                    
                    <div class="form-group">
                        <label for="lastName">Last Name</label>
                        <div class="input-wrapper">
                            <input type="text" id="lastName" name="lastName" placeholder="Enter last name" required>
                            <i class="fas fa-user icon"></i>
                        </div>
                        <span class="error-message">Please enter your last name</span>
                    </div>
                </div>
                
                <div class="form-group">
                    <label for="email">Email Address</label>
                    <div class="input-wrapper">
                        <input type="email" id="email" name="email" placeholder="Enter your email" required>
                        <i class="fas fa-envelope icon"></i>
                    </div>
                    <span class="error-message">Please enter a valid email address</span>
                </div>
                
                <div class="form-row">
                    <div class="form-group">
                        <label for="phone">Phone Number</label>
                        <div class="input-wrapper">
                            <input type="tel" id="phone" name="phone" placeholder="Enter phone number" required>
                            <i class="fas fa-phone icon"></i>
                        </div>
                        <span class="error-message">Please enter a valid phone number</span>
                    </div>
                    
                    <div class="form-group" id="dobGroup">
                        <label for="dob">Date de naissance</label>
                        <div class="input-wrapper">
                            <input type="date" id="dob" name="dob" required 
                                   min="{{ ('now'|date_modify('-120 years'))|date('Y-m-d') }}"
                                   max="{{ 'now'|date('Y-m-d') }}">
                            <i class="fas fa-calendar icon"></i>
                        </div>
                        <span class="error-message" id="dobError">Âge invalide. Il doit être entre 18 et 120 ans et ne peut pas être dans le futur.</span>
                    </div>
                </div>
                
                <div class="form-group">
                    <label for="password">Password</label>
                    <div class="input-wrapper">
                        <input type="password" id="password" name="password" placeholder="Create a password" required minlength="8">
                        <i class="fas fa-lock icon"></i>
                        <button type="button" class="password-toggle" onclick="togglePassword('password')">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    <div class="password-strength">
                        <div class="strength-bar">
                            <div class="strength-fill" id="strengthFill"></div>
                        </div>
                        <span class="strength-text" id="strengthText">Use 8+ characters with letters, numbers & symbols</span>
                    </div>
                </div>
                
                <div class="form-group">
                    <label for="confirmPassword">Confirm Password</label>
                    <div class="input-wrapper">
                        <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Confirm your password" required>
                        <i class="fas fa-lock icon"></i>
                        <button type="button" class="password-toggle" onclick="togglePassword('confirmPassword')">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    <span class="error-message">Passwords do not match</span>
                </div>
                
                <div class="terms-checkbox">
                    <input type="checkbox" id="terms" name="terms" required>
                    <label for="terms">
                        I agree to the <a href="{{ path('app_login') }}">Terms of Service</a> and <a href="{{ path('app_login') }}">Privacy Policy</a>
                    </label>
                </div>
                
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('register') }}">
                
                <button type="submit" class="auth-btn">
                    <i class="fas fa-user-plus"></i>
                    Create Account
                </button>
            </form>
            
            <div class="auth-divider">
                <span>or sign up with</span>
            </div>
            
            <div class="social-login">
                <button type="button" class="social-btn google">
                    <i class="fab fa-google"></i>
                    Google
                </button>
                <button type="button" class="social-btn facebook">
                    <i class="fab fa-facebook-f"></i>
                    Facebook
                </button>
            </div>
            
            <div class="auth-footer">
                Already have an account? <a href="{{ path('app_login') }}">Sign In</a>
            </div>
        </div>
    </div>
</section>

<script>
function togglePassword(inputId) {
    const input = document.getElementById(inputId);
    const icon = input.parentElement.querySelector('.password-toggle i');
    
    if (input.type === 'password') {
        input.type = 'text';
        icon.classList.remove('fa-eye');
        icon.classList.add('fa-eye-slash');
    } else {
        input.type = 'password';
        icon.classList.remove('fa-eye-slash');
        icon.classList.add('fa-eye');
    }
}

// Password strength checker
const passwordInput = document.getElementById('password');
const strengthFill = document.getElementById('strengthFill');
const strengthText = document.getElementById('strengthText');

passwordInput.addEventListener('input', function() {
    const password = this.value;
    let strength = 0;
    let text = '';
    
    if (password.length >= 8) strength++;
    if (password.match(/[a-z]/) && password.match(/[A-Z]/)) strength++;
    if (password.match(/\d/)) strength++;
    if (password.match(/[^a-zA-Z\d]/)) strength++;
    
    strengthFill.className = 'strength-fill';
    
    switch (strength) {
        case 0:
        case 1:
            strengthFill.classList.add('weak');
            text = 'Weak - Add more characters';
            break;
        case 2:
            strengthFill.classList.add('fair');
            text = 'Fair - Add numbers or symbols';
            break;
        case 3:
            strengthFill.classList.add('good');
            text = 'Good - Almost there!';
            break;
        case 4:
            strengthFill.classList.add('strong');
            text = 'Strong password!';
            break;
    }
    
    strengthText.textContent = text;
});

// Password confirmation validation
const confirmPassword = document.getElementById('confirmPassword');
confirmPassword.addEventListener('input', function() {
    const formGroup = this.closest('.form-group');
    if (this.value !== passwordInput.value) {
        formGroup.classList.add('error');
    } else {
        formGroup.classList.remove('error');
    }
});

const dobInput = document.getElementById('dob');
const dobGroup = document.getElementById('dobGroup');
const dobError = document.getElementById('dobError');
if (dobInput) {
    dobInput.addEventListener('change', function() {
        const dob = new Date(this.value);
        const today = new Date();
        let age = today.getFullYear() - dob.getFullYear();
        const m = today.getMonth() - dob.getMonth();
        if (m < 0 || (m === 0 && today.getDate() < dob.getDate())) { age--; }
        const invalid = isNaN(dob.getTime()) || dob > today || age < 18 || age > 120;
        if (invalid) { dobGroup.classList.add('error'); } else { dobGroup.classList.remove('error'); }
    });
}
</script>
{% endblock %}
