{% extends 'base.html.twig' %}

{% block title %}Our Doctors - MediDent{% endblock %}

{% block styles %}
<style>
    /* Page Header */
    .page-header {
        background: linear-gradient(135deg, rgba(26, 115, 167, 0.95), rgba(45, 189, 182, 0.9)), var(--page-header-image) center/cover;
        padding: 120px 0 80px;
        text-align: center;
        color: var(--white);
    }
    
    .page-header h1 {
        font-size: 48px;
        margin-bottom: 15px;
    }
    
    .breadcrumb {
        display: flex;
        justify-content: center;
        gap: 10px;
        list-style: none;
    }
    
    .breadcrumb a {
        color: rgba(255, 255, 255, 0.8);
    }
    
    .breadcrumb a:hover {
        color: var(--white);
    }
    
    .breadcrumb .active {
        color: var(--white);
    }
    
    /* Doctors Grid */
    .doctors-section {
        padding: 100px 0;
    }
    
    .doctors-filter {
        display: flex;
        justify-content: center;
        gap: 15px;
        margin-bottom: 50px;
        flex-wrap: wrap;
    }
    
    .filter-btn {
        padding: 12px 30px;
        border: 2px solid var(--gray-200);
        border-radius: 50px;
        background: var(--white);
        cursor: pointer;
        font-weight: 500;
        transition: var(--transition);
    }
    
    .filter-btn:hover,
    .filter-btn.active {
        background: var(--gradient);
        border-color: transparent;
        color: var(--white);
    }
    
    .doctors-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 40px;
    }
    
    .doctor-card-full {
        background: var(--white);
        border-radius: 20px;
        overflow: hidden;
        box-shadow: var(--shadow);
        transition: var(--transition);
    }
    
    .doctor-card-full:hover {
        transform: translateY(-10px);
        box-shadow: var(--shadow-hover);
    }
    
    .doctor-card-image {
        position: relative;
        overflow: hidden;
    }
    
    .doctor-card-image img {
        width: 100%;
        height: 350px;
        object-fit: cover;
        transition: var(--transition);
    }
    
    .doctor-card-full:hover .doctor-card-image img {
        transform: scale(1.05);
    }
    
    .doctor-specialty-badge {
        position: absolute;
        top: 20px;
        left: 20px;
        background: var(--gradient);
        color: var(--white);
        padding: 8px 20px;
        border-radius: 50px;
        font-size: 13px;
        font-weight: 500;
    }
    
    .doctor-card-content {
        padding: 30px;
    }
    
    .doctor-card-content h3 {
        font-size: 22px;
        color: var(--dark-blue);
        margin-bottom: 5px;
    }
    
    .doctor-card-content .specialty {
        color: var(--primary-teal);
        font-weight: 500;
        margin-bottom: 15px;
    }
    
    .doctor-card-content p {
        color: var(--gray-600);
        font-size: 14px;
        line-height: 1.7;
        margin-bottom: 20px;
    }
    
    .doctor-info-list {
        list-style: none;
        margin-bottom: 20px;
    }
    
    .doctor-info-list li {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 0;
        border-bottom: 1px solid var(--gray-200);
        font-size: 14px;
    }
    
    .doctor-info-list li:last-child {
        border-bottom: none;
    }
    
    .doctor-info-list i {
        color: var(--primary-teal);
        width: 20px;
    }
    
    .doctor-card-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 20px;
        border-top: 1px solid var(--gray-200);
    }
    
    .doctor-social-links {
        display: flex;
        gap: 10px;
    }
    
    .doctor-social-links a {
        width: 40px;
        height: 40px;
        background: var(--light-blue);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--primary-blue);
        transition: var(--transition);
    }
    
    .doctor-social-links a:hover {
        background: var(--gradient);
        color: var(--white);
    }
    
    /* Call to Action */
    .join-team-section {
        background: var(--light-blue);
        padding: 80px 0;
    }
    
    .join-team-content {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 60px;
        align-items: center;
    }
    
    .join-team-text h2 {
        font-size: 36px;
        color: var(--dark-blue);
        margin-bottom: 20px;
    }
    
    .join-team-text p {
        color: var(--gray-600);
        margin-bottom: 30px;
        line-height: 1.8;
    }
    
    .join-team-image img {
        width: 100%;
        border-radius: 20px;
        box-shadow: var(--shadow);
    }
    
    @media (max-width: 1024px) {
        .doctors-grid {
            grid-template-columns: repeat(2, 1fr);
        }
        
        .join-team-content {
            grid-template-columns: 1fr;
        }
    }
    
    @media (max-width: 768px) {
        .doctors-grid {
            grid-template-columns: 1fr;
        }
        
        .page-header h1 {
            font-size: 32px;
        }
    }
</style>
{% endblock %}

{% block body %}
