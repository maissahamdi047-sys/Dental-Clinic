{% extends 'base.html.twig' %}

{% block title %}Admin - MediDent{% endblock %}

{% block styles %}
<style>
    .page-header { background: linear-gradient(135deg, rgba(26,115,167,0.95), rgba(45,189,182,0.9)), var(--page-header-image) center/cover; padding: 120px 0 80px; text-align: center; color: var(--white); }
    .admin-section { padding: 80px 0; }
    .admin-grid { display: grid; grid-template-columns: 2fr 1fr; gap: 40px; }
    .cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 30px; }
    .card { background: var(--white); border-radius: 16px; padding: 24px; box-shadow: var(--shadow); text-align: center; }
    .card h3 { font-size: 14px; color: var(--gray-600); margin-bottom: 8px; }
    .card .value { font-size: 28px; color: var(--dark-blue); }
    .admin-card { background: var(--white); border-radius: 20px; padding: 40px; box-shadow: var(--shadow); }
    .admin-card h2 { font-size: 28px; color: var(--dark-blue); margin-bottom: 20px; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    .form-group { margin-bottom: 18px; }
    .form-group label { display: block; font-weight: 500; margin-bottom: 8px; color: var(--gray-800); }
    .form-group input, .form-group textarea { width: 100%; padding: 15px 20px; border: 2px solid var(--gray-200); border-radius: 12px; font-family: inherit; font-size: 15px; transition: var(--transition); }
    .form-group textarea { min-height: 120px; resize: vertical; }
    .form-group input:focus, .form-group textarea:focus { outline: none; border-color: var(--primary-teal); box-shadow: 0 0 0 4px rgba(45,189,182,0.1); }
    .summary-item { display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid var(--gray-200); }
    .summary-item:last-child { border-bottom: none; }
</style>
{% endblock %}

{% block body %}
<section class="page-header" style="--page-header-image: url('https://images.unsplash.com/photo-1588771934966-7aa12acb266a?q=80&w=1920&auto=format&fit=crop')">
    <div class="container">
        <h1>Admin Panel</h1>
        <ul class="breadcrumb">
            <li><a href="{{ path('app_home') }}">Home</a></li>
            <li>/</li>
            <li class="active">Admin</li>
        </ul>
    </div>
</section>

<section class="admin-section">
    <div class="container">
        
        <div class="cards">
            <div class="card">
                <h3>Total Users</h3>
                <div class="value">{{ countUsers }}</div>
            </div>
            <div class="card">
                <h3>Appointments</h3>
                <div class="value">{{ countAppointments }}</div>
            </div>
            <div class="card">
                <h3>Pending Approval</h3>
                <div class="value">{{ countPending }}</div>
            </div>
            <div class="card">
                <h3>Payments</h3>
                <div class="value">{{ countPayments }}</div>
            </div>
        </div>
        
        <div class="admin-grid">
            <div class="admin-card">
                <h2>Quick Actions</h2>
                <p>Manage core operations</p>
                <div style="display:flex; gap:10px; flex-wrap:wrap; margin-bottom:20px;">
                    <a href="{{ path('app_admin_appointments') }}" class="btn btn-primary">View Appointments</a>
                    <a href="{{ path('app_admin_users') }}" class="btn btn-outline">Manage Users</a>
                    <a href="{{ path('app_admin_documents') }}" class="btn btn-outline">Send Prescriptions</a>
                    <a href="{{ path('app_admin_payments') }}" class="btn btn-outline">Payments</a>
                    <a href="{{ path('app_admin_services') }}" class="btn btn-outline">Services</a>
                    <a href="{{ path('app_admin_messages') }}" class="btn btn-outline">Messages</a>
                </div>
                <h2>Site Settings</h2>
                <form method="POST" action="{{ path('app_admin') }}">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="site_name">Site Name</label>
                            <input id="site_name" name="site_name" type="text" placeholder="MediDent" value="{{ posted.site_name|default('MediDent') }}">
                        </div>
                        <div class="form-group">
                            <label for="email">Contact Email</label>
                            <input id="email" name="email" type="email" placeholder="info@medident.com" value="{{ posted.email|default('') }}">
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="phone">Phone</label>
                            <input id="phone" name="phone" type="tel" placeholder="+1 (234) 567-890" value="{{ posted.phone|default('') }}">
                        </div>
                        <div class="form-group">
                            <label for="address">Address</label>
                            <input id="address" name="address" type="text" placeholder="123 Medical Center Drive" value="{{ posted.address|default('') }}">
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="hours">Working Hours</label>
                        <textarea id="hours" name="hours" placeholder="Mon-Fri: 8:00 - 19:00">{{ posted.hours|default('') }}</textarea>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="hero_image_url">Hero Image URL</label>
                            <input id="hero_image_url" name="hero_image_url" type="url" placeholder="https://..." value="{{ posted.hero_image_url|default('') }}">
                        </div>
                        <div class="form-group">
                            <label for="logo_url">Logo URL</label>
                            <input id="logo_url" name="logo_url" type="url" placeholder="https://..." value="{{ posted.logo_url|default('') }}">
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary" style="width: 100%;">
                        Save Settings
                    </button>
                </form>
            </div>

            <div class="admin-card">
                <h2>Recent Appointments</h2>
                <ul>
                    {% for a in recentAppointments %}
                        <li>#{{ a.id }} — {{ a.patient }} — {{ a.scheduledAt|date('Y-m-d H:i') }} — {{ a.status }}</li>
                    {% else %}
                        <li>No recent appointments</li>
                    {% endfor %}
                </ul>
                <hr style="margin:20px 0;">
                <h2>Preview</h2>
                <div class="summary-item"><span>Site Name</span><span>{{ posted.site_name|default('MediDent') }}</span></div>
                <div class="summary-item"><span>Email</span><span>{{ posted.email|default('') }}</span></div>
                <div class="summary-item"><span>Phone</span><span>{{ posted.phone|default('') }}</span></div>
                <div class="summary-item"><span>Address</span><span>{{ posted.address|default('') }}</span></div>
                <div class="summary-item"><span>Hero Image</span><span>{{ posted.hero_image_url|default('') }}</span></div>
                <div class="summary-item"><span>Logo</span><span>{{ posted.logo_url|default('') }}</span></div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
