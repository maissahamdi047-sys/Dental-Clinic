{% extends 'base.html.twig' %}

{% block title %}Admin Login - MediDent{% endblock %}

{% block styles %}
<style>
    .page-header { background: linear-gradient(135deg, rgba(26,115,167,0.95), rgba(45,189,182,0.9)), var(--page-header-image) center/cover; padding: 120px 0 80px; text-align: center; color: var(--white); }
    .admin-login { padding: 80px 0; }
    .card { background: var(--white); border-radius: 16px; padding: 30px; box-shadow: var(--shadow); max-width: 520px; margin: 0 auto; }
    .form-group { margin-bottom: 16px; }
    .form-group label { display:block; margin-bottom:6px; }
    .form-group input { width:100%; padding: 12px 16px; border:2px solid var(--gray-200); border-radius:10px; }
</style>
{% endblock %}

{% block body %}
<section class="page-header" style="--page-header-image: url('https://images.unsplash.com/photo-1588771934966-7aa12acb266a?q=80&w=1920&auto=format&fit=crop')">
    <div class="container">
        <h1>Admin Login</h1>
    </div>
</section>

<section class="admin-login">
    <div class="container">
        <div class="card">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label }}">{{ message }}</div>
                {% endfor %}
            {% endfor %}
            <form method="post" action="{{ path('app_admin_login') }}">
                <div class="form-group"><label>Email</label><input type="email" name="email" required></div>
                <div class="form-group"><label>Password</label><input type="password" name="password" required></div>
                <button type="submit" class="btn btn-primary" style="width:100%;">Login</button>
            </form>
        </div>
    </div>
</section>
{% endblock %}

