{% extends 'base.html.twig' %}

{% block title %}Admin Users - MediDent{% endblock %}

{% block styles %}
<style>
    .page-header { background: linear-gradient(135deg, rgba(26,115,167,0.95), rgba(45,189,182,0.9)), var(--page-header-image) center/cover; padding: 120px 0 80px; text-align: center; color: var(--white); }
    .admin-section { padding: 80px 0; }
    .admin-card { background: var(--white); border-radius: 20px; padding: 40px; box-shadow: var(--shadow); }
    .admin-toolbar { display: flex; justify-content: space-between; margin-bottom: 20px; }
    .table { width: 100%; border-collapse: collapse; }
    .table th, .table td { padding: 14px 16px; border-bottom: 1px solid var(--gray-200); text-align: left; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 20px; }
    .form-group { margin-bottom: 12px; }
    .form-group label { display: block; font-weight: 500; margin-bottom: 6px; color: var(--gray-800); }
    .form-group input, .form-group select { width: 100%; padding: 12px 16px; border: 2px solid var(--gray-200); border-radius: 10px; }
</style>
{% endblock %}

{% block body %}
<section class="page-header" style="--page-header-image: url('https://images.unsplash.com/photo-1588771934966-7aa12acb266a?q=80&w=1920&auto=format&fit=crop')">
    <div class="container">
        <h1>Manage Users</h1>
        <ul class="breadcrumb">
            <li><a href="{{ path('app_admin') }}">Admin</a></li>
            <li>/</li>
            <li class="active">Users</li>
        </ul>
    </div>
</section>

<section class="admin-section">
    <div class="container">
        <div class="admin-card">
            <div class="admin-toolbar">
                <div>
                    <input type="text" id="userSearch" placeholder="Search users" style="padding: 10px 14px; border: 2px solid var(--gray-200); border-radius: 10px;">
                </div>
                <div>
                    <a href="#" class="btn btn-primary" id="addUserBtn">Add User</a>
                </div>
            </div>
            <table class="table" id="usersTable">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for u in users %}
                        <tr>
                            <td>{{ u.name }}</td>
                            <td>{{ u.email }}</td>
                            <td>{{ u.role }}</td>
                            <td>{{ u.status }}</td>
                            <td>
                                <form method="post" action="{{ path('app_admin_users_delete', {id: u.id}) }}">
                                    <button type="submit" class="btn btn-secondary">Delete</button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="5">No users yet</td></tr>
                    {% endfor %}
                </tbody>
            </table>

            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label }}">{{ message }}</div>
                {% endfor %}
            {% endfor %}

            <form id="addUserForm" method="POST" action="{{ path('app_admin_users') }}" style="display:none;">
                <div class="form-row">
                    <div class="form-group">
                        <label for="name">Name</label>
                        <input id="name" name="name" type="text" required>
                    </div>
                    <div class="form-group">
                        <label for="email">Email</label>
                        <input id="email" name="email" type="email" required>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label for="role">Role</label>
                        <select id="role" name="role"><option>Staff</option><option>Admin</option></select>
                    </div>
                    <div class="form-group">
                        <label for="status">Status</label>
                        <select id="status" name="status"><option>Active</option><option>Disabled</option></select>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary" id="saveUser">Save User</button>
            </form>
        </div>
    </div>
</section>
{% endblock %}

{% block scripts %}
<script>
    const addUserBtn = document.getElementById('addUserBtn');
    const addUserForm = document.getElementById('addUserForm');
    addUserBtn.addEventListener('click', (e) => { e.preventDefault(); addUserForm.style.display = addUserForm.style.display === 'none' ? 'block' : 'none'; });
</script>
{% endblock %}
