{% extends 'base.html.twig' %}

{% block title %}Admin Appointments - MediDent{% endblock %}

{% block styles %}
<style>
    .page-header { background: linear-gradient(135deg, rgba(26,115,167,0.95), rgba(45,189,182,0.9)), var(--page-header-image) center/cover; padding: 120px 0 80px; text-align: center; color: var(--white); }
    .admin-section { padding: 80px 0; }
    .admin-card { background: var(--white); border-radius: 20px; padding: 40px; box-shadow: var(--shadow); }
    .table { width: 100%; border-collapse: collapse; }
    .table th, .table td { padding: 14px 16px; border-bottom: 1px solid var(--gray-200); text-align: left; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 20px; }
    .form-group { margin-bottom: 12px; }
    .form-group label { display: block; font-weight: 500; margin-bottom: 6px; color: var(--gray-800); }
    .form-group input, .form-group select { width: 100%; padding: 12px 16px; border: 2px solid var(--gray-200); border-radius: 10px; }
    .status-badge { display:inline-block; padding:6px 12px; border-radius:999px; font-size:12px; font-weight:600; }
    .status-accepted { background:#d1fae5; color:#065f46; border:1px solid #a7f3d0; }
    .status-refused { background:#fee2e2; color:#991b1b; border:1px solid #fecaca; }
    .status-pending { background:#fef3c7; color:#92400e; border:1px solid #fde68a; }
    .status-cancelled { background:#e5e7eb; color:#374151; border:1px solid #d1d5db; }
</style>
{% endblock %}

{% block body %}
<section class="page-header" style="--page-header-image: url('https://images.unsplash.com/photo-1588771934966-7aa12acb266a?q=80&w=1920&auto=format&fit=crop')">
    <div class="container">
        <h1>Manage Appointments</h1>
        <ul class="breadcrumb">
            <li><a href="{{ path('app_admin') }}">Admin</a></li>
            <li>/</li>
            <li class="active">Appointments</li>
        </ul>
    </div>
</section>

<section class="admin-section">
    <div class="container">
        <div class="admin-card">
            <table class="table" id="appointmentsTable">
                <thead>
                    <tr>
                        <th>Patient</th>
                        <th>Service</th>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Doctor</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for a in appointments %}
                        <tr>
                            <td>{{ a.patient }}</td>
                            <td>{{ a.service }}</td>
                            <td>{{ a.scheduledAt|date('Y-m-d') }}</td>
                            <td>{{ a.scheduledAt|date('H:i') }}</td>
                            <td>{{ a.doctor }}</td>
                            <td>
                                {% set st = a.status %}
                                <span class="status-badge 
                                    {% if st == 'Accepted' %}status-accepted
                                    {% elseif st == 'Refused' %}status-refused
                                    {% elseif st in ['Pending Approval','Scheduled'] %}status-pending
                                    {% elseif st == 'Cancelled' %}status-cancelled
                                    {% endif %}">
                                    {{ st }}
                                </span>
                            </td>
                            <td>
                                <form method="post" action="{{ path('app_admin_appointment_status', {id: a.id}) }}" style="display:inline;">
                                    <input type="hidden" name="status" value="Accepted">
                                    <button type="submit" class="btn btn-primary">Accept</button>
                                </form>
                                <form method="post" action="{{ path('app_admin_appointment_status', {id: a.id}) }}" style="display:inline; margin-left:6px;">
                                    <input type="hidden" name="status" value="Refused">
                                    <button type="submit" class="btn btn-secondary">Refuse</button>
                                </form>
                                <form method="post" action="{{ path('app_admin_appointment_status', {id: a.id}) }}" style="display:inline; margin-left:6px;">
                                    <input type="hidden" name="status" value="Cancelled">
                                    <button type="submit" class="btn btn-outline">Cancel</button>
                                </form>
                                <form method="post" action="{{ path('app_admin_appointments_delete', {id: a.id}) }}" style="display:inline; margin-left:6px;">
                                    <button type="submit" class="btn btn-secondary">Delete</button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="7">No appointments yet</td></tr>
                    {% endfor %}
                </tbody>
            </table>

            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label }}">{{ message }}</div>
                {% endfor %}
            {% endfor %}

            <form id="newAppointmentForm" method="POST" action="{{ path('app_admin_appointments') }}" style="margin-top: 20px;">
                <div class="form-row">
                    <div class="form-group"><label>Patient</label><input id="apPatient" name="patient" type="text" required></div>
                    <div class="form-group"><label>Service</label><select id="apService" name="service"><option>General</option><option>Cosmetic</option><option>Orthodontics</option></select></div>
                </div>
                <div class="form-row">
                    <div class="form-group"><label>Date</label><input id="apDate" name="date" type="date" required></div>
                    <div class="form-group"><label>Time</label><input id="apTime" name="time" type="time" required></div>
                </div>
                <div class="form-row">
                    <div class="form-group"><label>Doctor</label><select id="apDoctor" name="doctor"><option>Dr. Smith</option><option>Dr. Johnson</option><option>Dr. Lee</option></select></div>
                    <div class="form-group"><label>Status</label><select id="apStatus" name="status"><option>Scheduled</option><option>Completed</option><option>Cancelled</option></select></div>
                </div>
                <button type="submit" class="btn btn-primary" id="addAppointment">Add Appointment</button>
            </form>
        </div>
    </div>
</section>
{% endblock %}

{% block scripts %}
<script>
    
</script>
{% endblock %}
