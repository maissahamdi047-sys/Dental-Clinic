{% extends 'base.html.twig' %}

{% block title %}Admin Services - MediDent{% endblock %}

{% block styles %}
<style>
    .page-header { background: linear-gradient(135deg, rgba(26,115,167,0.95), rgba(45,189,182,0.9)), var(--page-header-image) center/cover; padding: 120px 0 80px; text-align: center; color: var(--white); }
    .admin-section { padding: 80px 0; }
    .admin-card { background: var(--white); border-radius: 20px; padding: 40px; box-shadow: var(--shadow); }
    .table { width: 100%; border-collapse: collapse; table-layout: fixed; }
    .table th, .table td { padding: 12px 12px; border-bottom: 1px solid var(--gray-200); text-align: left; vertical-align: top; }
    .table td input, .table td select, .table td textarea { width: 100%; }
    .table-responsive { overflow-x: auto; }
    @media (max-width: 992px) {
        .table thead { display: none; }
        .table, .table tbody, .table tr, .table td { display: block; width: 100%; }
        .table tr { background: var(--white); border: 1px solid var(--gray-200); border-radius: 12px; padding: 12px; margin-bottom: 12px; }
        .table td { padding: 8px 0; }
        .table td::before { content: attr(data-label); display: block; font-weight: 600; color: var(--gray-700); margin-bottom: 6px; }
        .table td:last-child { display: flex; gap: 8px; }
    }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 20px; }
    .form-group { margin-bottom: 12px; }
    .form-group label { display: block; font-weight: 500; margin-bottom: 6px; color: var(--gray-800); }
    .form-group input, .form-group select, .form-group textarea { width: 100%; padding: 12px 16px; border: 2px solid var(--gray-200); border-radius: 10px; }
</style>
{% endblock %}

{% block body %}
<section class="page-header" style="--page-header-image: url('https://images.unsplash.com/photo-1588771934966-7aa12acb266a?q=80&w=1920&auto=format&fit=crop')">
    <div class="container">
        <h1>Manage Services</h1>
        <ul class="breadcrumb">
            <li><a href="{{ path('app_admin') }}">Admin</a></li>
            <li>/</li>
            <li class="active">Services</li>
        </ul>
    </div>
</section>

<section class="admin-section">
    <div class="container">
        <div class="admin-card">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label }}">{{ message }}</div>
                {% endfor %}
            {% endfor %}
            <h2>Create Service</h2>
            <form method="post" action="{{ path('app_admin_services') }}">
                <input type="hidden" name="mode" value="create">
                <div class="form-row">
                    <div class="form-group"><label>Name</label><input name="name" required></div>
                    <div class="form-group"><label>Slug</label><input name="slug" required></div>
                </div>
                <div class="form-row">
                    <div class="form-group"><label>Price</label><input name="price" type="number" step="0.01" min="0"></div>
                    <div class="form-group"><label>Duration (min)</label><input name="duration" type="number" min="10" value="60"></div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Category</label>
                        <select name="category">
                            <option value="General Dentistry">General Dentistry</option>
                            <option value="Cosmetic Dentistry">Cosmetic Dentistry</option>
                            <option value="Orthodontics">Orthodontics</option>
                            <option value="Dental Implants">Dental Implants</option>
                            <option value="Pediatric Dentistry">Pediatric Dentistry</option>
                            <option value="Emergency Care">Emergency Care</option>
                        </select>
                    </div>
                </div>
                <div class="form-group"><label>Image URL</label><input name="imageUrl" type="url"></div>
                <div class="form-group"><label>Description</label><textarea name="description"></textarea></div>
                <button type="submit" class="btn btn-primary">Create</button>
            </form>
        </div>

        <div class="admin-card" style="margin-top:30px;">
            <h2>All Services</h2>
            <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Slug</th>
                        <th>Price</th>
                        <th>Duration</th>
                        <th>Category</th>
                        <th>Image</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for s in services %}
                        <tr>
                            <td data-label="Name">
                                <form method="post" action="{{ path('app_admin_services') }}">
                                    <input type="hidden" name="mode" value="update">
                                    <input type="hidden" name="id" value="{{ s.id }}">
                                    <input name="name" value="{{ s.name }}">
                            </td>
                            <td data-label="Slug"><input name="slug" value="{{ s.slug }}"></td>
                            <td data-label="Price"><input name="price" type="number" step="0.01" value="{{ s.price }}"></td>
                            <td data-label="Duration"><input name="duration" type="number" value="{{ s.durationMin }}"></td>
                            <td data-label="Category">
                                <select name="category">
                                    <option value="General Dentistry" {{ s.category == 'General Dentistry' ? 'selected' : '' }}>General Dentistry</option>
                                    <option value="Cosmetic Dentistry" {{ s.category == 'Cosmetic Dentistry' ? 'selected' : '' }}>Cosmetic Dentistry</option>
                                    <option value="Orthodontics" {{ s.category == 'Orthodontics' ? 'selected' : '' }}>Orthodontics</option>
                                    <option value="Dental Implants" {{ s.category == 'Dental Implants' ? 'selected' : '' }}>Dental Implants</option>
                                    <option value="Pediatric Dentistry" {{ s.category == 'Pediatric Dentistry' ? 'selected' : '' }}>Pediatric Dentistry</option>
                                    <option value="Emergency Care" {{ s.category == 'Emergency Care' ? 'selected' : '' }}>Emergency Care</option>
                                </select>
                            </td>
                            <td data-label="Image"><input name="imageUrl" value="{{ s.imageUrl }}"></td>
                            <td data-label="Description"><textarea name="description">{{ s.description }}</textarea></td>
                            <td data-label="Actions">
                                    <button type="submit" class="btn btn-primary">Save</button>
                                </form>
                                <form method="post" action="{{ path('app_admin_services_delete', {id: s.id}) }}" style="margin-top:6px;">
                                    <button type="submit" class="btn btn-secondary">Delete</button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="7">No services yet</td></tr>
                    {% endfor %}
                </tbody>
            </table>
            </div>
        </div>
    </div>
</section>
{% endblock %}
